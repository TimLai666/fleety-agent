{"name":"mkdir_then_write_inside","description":"Agent creates a directory then writes a file inside it.","workspace_files":{},"user_input":"Create logs/ and put 'first log' into logs/run.txt.","scripted_responses":[{"tool_calls":[{"id":"c1","name":"make_dir","arguments":{"path":"logs"}}]},{"tool_calls":[{"id":"c2","name":"write_file","arguments":{"path":"logs/run.txt","content":"first log"}}]},{"content":"Created logs/ and wrote logs/run.txt.","tool_calls":[]}],"expected":{"tools_called":["make_dir","write_file"],"must_not_call":["delete_file"],"final_contains":["run.txt"],"workspace_files_after":{"logs/run.txt":"first log"}}}
{"name":"read_two_files_and_combine","description":"Agent reads two separate files and combines info in the answer.","workspace_files":{"left.txt":"alpha","right.txt":"beta"},"user_input":"Tell me what's in left.txt and right.txt.","scripted_responses":[{"tool_calls":[{"id":"c1","name":"read_file","arguments":{"path":"left.txt"}}]},{"tool_calls":[{"id":"c2","name":"read_file","arguments":{"path":"right.txt"}}]},{"content":"left.txt is alpha and right.txt is beta.","tool_calls":[]}],"expected":{"tools_called":["read_file","read_file"],"must_not_call":["write_file","edit_file"],"final_contains":["alpha","beta"]}}
{"name":"multistep_search_then_read","description":"Multi-step: search → read → summarize.","workspace_files":{"src/lib.rs":"pub fn add(a:i32,b:i32)->i32{a+b}\npub fn sub(a:i32,b:i32)->i32{a-b}","src/main.rs":"fn main(){}"},"user_input":"Which file defines 'sub'? Show me the file.","scripted_responses":[{"tool_calls":[{"id":"c1","name":"search_files","arguments":{"query":"pub fn sub"}}]},{"tool_calls":[{"id":"c2","name":"read_file","arguments":{"path":"src/lib.rs"}}]},{"content":"'sub' is defined in src/lib.rs.","tool_calls":[]}],"expected":{"tools_called":["search_files","read_file"],"must_not_call":["write_file","edit_file"],"final_contains":["src/lib.rs"]}}
