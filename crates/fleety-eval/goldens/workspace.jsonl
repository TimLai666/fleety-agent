{"name":"list_dir_then_read","description":"Agent lists a directory then reads a discovered file.","workspace_files":{"src/main.rs":"fn main(){println!(\"hi\");}","src/lib.rs":"pub fn add(a:i32,b:i32)->i32{a+b}"},"user_input":"What's in the src directory? Read main.rs.","scripted_responses":[{"tool_calls":[{"id":"c1","name":"list_dir","arguments":{"path":"src"}}]},{"tool_calls":[{"id":"c2","name":"read_file","arguments":{"path":"src/main.rs"}}]},{"content":"src has main.rs and lib.rs; main prints hi.","tool_calls":[]}],"expected":{"tools_called":["list_dir","read_file"],"must_not_call":["write_file"],"final_contains":["main","lib"]}}
